---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    icon: 'shield',
    title: 'Cybersecurity Solutions',
    description: 'Comprehensive security services including threat detection, vulnerability assessments, and compliance management to protect your digital assets.',
    features: ['Penetration Testing', 'Security Audits', 'Compliance (SOC 2, ISO 27001)', 'Incident Response'],
  },
  {
    icon: 'server',
    title: 'Infrastructure Management',
    description: 'Scalable and reliable infrastructure solutions leveraging cloud technologies and best practices for optimal performance.',
    features: ['Cloud Migration', 'Network Architecture', 'Server Management', 'Disaster Recovery'],
  },
  {
    icon: 'code',
    title: 'IT Implementation',
    description: 'End-to-end implementation services for enterprise software, custom solutions, and technology integrations.',
    features: ['System Integration', 'ERP/CRM Implementation', 'Custom Development', 'API Integration'],
  },
  {
    icon: 'tools',
    title: 'Maintenance & Support',
    description: '24/7 monitoring and support services ensuring your systems run smoothly with minimal downtime.',
    features: ['24/7 Monitoring', 'Helpdesk Support', 'System Updates', 'Performance Optimization'],
  },
];

const stats = [
  { value: '500+', label: 'Projects Completed' },
  { value: '200+', label: 'Happy Clients' },
  { value: '99.9%', label: 'Uptime SLA' },
  { value: '24/7', label: 'Support Available' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'IT Vendor Solutions',
  description: 'Leading IT solutions provider specializing in security, infrastructure, implementation, and maintenance',
  url: 'https://your-domain.com',
  logo: 'https://your-domain.com/images/logo.png',
  foundingDate: '2010',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+1-234-567-890',
    contactType: 'customer service',
    areaServed: 'US',
    availableLanguage: 'en',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '123 Tech Street',
    addressLocality: 'San Francisco',
    addressRegion: 'CA',
    postalCode: '94105',
    addressCountry: 'US',
  },
  sameAs: [
    'https://linkedin.com/company/yourcompany',
    'https://twitter.com/yourcompany',
    'https://github.com/yourcompany',
  ],
};
---

<Layout
  title="IT Vendor Solutions - Enterprise IT Services & Solutions"
  description="Leading IT solutions provider specializing in cybersecurity, infrastructure management, IT implementation, and 24/7 maintenance support. Transform your business with our expert IT services."
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-primary-600 via-primary-700 to-primary-900 text-white section-padding overflow-hidden">
    <div class="absolute inset-0 bg-grid-white/10 bg-[size:20px_20px]"></div>
    <div class="container-custom relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="mb-6 animate-fade-in">
          Transform Your Business with
          <span class="block text-transparent bg-clip-text bg-gradient-to-r from-blue-200 to-cyan-200">
            Expert IT Solutions
          </span>
        </h1>
        <p class="text-xl md:text-2xl text-blue-100 mb-8 leading-relaxed">
          We deliver cutting-edge IT services in security, infrastructure, implementation, and support to drive your business forward.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="btn bg-white text-primary-700 hover:bg-blue-50 px-8 py-4 text-lg">
            Get Started Today
          </a>
          <a href="/services" class="btn bg-primary-500 text-white hover:bg-primary-600 px-8 py-4 text-lg border-2 border-white/20">
            Explore Services
          </a>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-white to-transparent"></div>
  </section>

  <!-- Stats Section -->
  <section class="bg-secondary-50 py-12">
    <div class="container-custom">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-4xl md:text-5xl font-bold text-primary-600 mb-2">{stat.value}</div>
            <div class="text-secondary-600 font-medium">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="mb-4">Our Core Services</h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          Comprehensive IT solutions tailored to meet your business needs and drive digital transformation.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {services.map((service) => (
          <div class="group bg-white rounded-2xl p-8 border-2 border-secondary-100 hover:border-primary-300 hover:shadow-xl transition-all duration-300">
            <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              {service.icon === 'shield' && (
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              )}
              {service.icon === 'server' && (
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
                </svg>
              )}
              {service.icon === 'code' && (
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                </svg>
              )}
              {service.icon === 'tools' && (
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              )}
            </div>
            <h3 class="text-2xl font-bold mb-4 text-secondary-900">{service.title}</h3>
            <p class="text-secondary-600 mb-6 leading-relaxed">{service.description}</p>
            <ul class="space-y-2">
              {service.features.map((feature) => (
                <li class="flex items-center text-secondary-700">
                  <svg class="w-5 h-5 text-primary-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="text-center mt-12">
        <a href="/services" class="btn btn-primary px-8 py-4 text-lg">
          View All Services
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="section-padding bg-secondary-50">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="mb-6">Why Choose IT Vendor Solutions?</h2>
          <p class="text-lg text-secondary-600 mb-8 leading-relaxed">
            With over a decade of experience, we've helped hundreds of businesses achieve their digital transformation goals through innovative IT solutions and unwavering support.
          </p>
          <div class="space-y-6">
            <div class="flex items-start">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0 mr-4">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold mb-2">Proven Expertise</h3>
                <p class="text-secondary-600">Industry-certified professionals with deep technical knowledge and real-world experience.</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0 mr-4">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold mb-2">Rapid Deployment</h3>
                <p class="text-secondary-600">Fast implementation timelines without compromising on quality or security.</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0 mr-4">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold mb-2">24/7 Support</h3>
                <p class="text-secondary-600">Round-the-clock monitoring and support to ensure your systems are always operational.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-br from-primary-600 to-primary-900 rounded-2xl p-8 text-white">
          <h3 class="text-3xl font-bold mb-6">Ready to Get Started?</h3>
          <p class="text-blue-100 mb-8 text-lg">
            Let's discuss how we can help transform your IT infrastructure and drive your business forward.
          </p>
          <ul class="space-y-4 mb-8">
            <li class="flex items-center">
              <svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Free initial consultation
            </li>
            <li class="flex items-center">
              <svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Custom solutions tailored to your needs
            </li>
            <li class="flex items-center">
              <svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Transparent pricing and timelines
            </li>
          </ul>
          <a href="/contact" class="btn bg-white text-primary-700 hover:bg-blue-50 w-full justify-center text-lg py-4">
            Schedule a Consultation
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding bg-gradient-to-r from-primary-600 to-primary-800 text-white">
    <div class="container-custom text-center">
      <h2 class="mb-6 text-white">Let's Build Something Great Together</h2>
      <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
        Partner with us to leverage cutting-edge technology and expert guidance for your business success.
      </p>
      <a href="/contact" class="btn bg-white text-primary-700 hover:bg-blue-50 px-8 py-4 text-lg">
        Contact Us Today
      </a>
    </div>
  </section>
</Layout>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.6s ease-out;
  }

  .bg-grid-white\/10 {
    background-image: linear-gradient(to right, rgba(255, 255, 255, 0.1) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
  }
</style>
