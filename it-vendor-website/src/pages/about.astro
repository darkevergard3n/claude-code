---
import Layout from '../layouts/Layout.astro';

const values = [
  {
    title: 'Excellence',
    description: 'We strive for excellence in every project, delivering solutions that exceed expectations.',
    icon: 'star',
  },
  {
    title: 'Innovation',
    description: 'Staying ahead of technology trends to provide cutting-edge solutions for our clients.',
    icon: 'lightbulb',
  },
  {
    title: 'Integrity',
    description: 'Transparent communication and honest recommendations guide all our client relationships.',
    icon: 'shield-check',
  },
  {
    title: 'Partnership',
    description: 'We view our clients as partners, working collaboratively toward shared success.',
    icon: 'users',
  },
];

const team = [
  {
    name: 'John Anderson',
    role: 'Chief Technology Officer',
    expertise: '15+ years in enterprise IT',
  },
  {
    name: 'Sarah Martinez',
    role: 'Head of Security',
    expertise: 'CISSP, CEH certified',
  },
  {
    name: 'Michael Chen',
    role: 'Infrastructure Lead',
    expertise: 'Cloud architecture specialist',
  },
  {
    name: 'Emily Thompson',
    role: 'Implementation Director',
    expertise: 'PMP, Agile certified',
  },
];

const certifications = [
  'AWS Advanced Consulting Partner',
  'Microsoft Gold Partner',
  'ISO 27001 Certified',
  'SOC 2 Type II Compliant',
  'Cisco Premier Partner',
  'VMware Enterprise Partner',
];
---

<Layout
  title="About Us - IT Vendor Solutions | Expert IT Services Team"
  description="Learn about IT Vendor Solutions - a leading IT services provider with over 10 years of experience in cybersecurity, infrastructure, and IT implementation. Meet our expert team."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary-600 to-primary-900 text-white section-padding">
    <div class="container-custom text-center">
      <h1 class="mb-6">About IT Vendor Solutions</h1>
      <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto leading-relaxed">
        Empowering businesses through innovative IT solutions since 2010
      </p>
    </div>
  </section>

  <!-- Company Story -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="mb-6">Our Story</h2>
          <div class="space-y-4 text-lg text-secondary-700 leading-relaxed">
            <p>
              Founded in 2010, IT Vendor Solutions began with a simple mission: to provide businesses with reliable, innovative IT services that drive real results. What started as a small team of passionate technologists has grown into a leading IT solutions provider serving over 200 clients worldwide.
            </p>
            <p>
              We've built our reputation on technical excellence, unwavering commitment to client success, and the ability to deliver complex IT solutions with clarity and precision. Our team combines deep technical expertise with business acumen to ensure technology investments deliver measurable value.
            </p>
            <p>
              Today, we continue to innovate and adapt, staying at the forefront of technology trends while maintaining the personalized service that has been our hallmark from day one.
            </p>
          </div>
        </div>
        <div class="bg-gradient-to-br from-primary-50 to-blue-50 rounded-2xl p-8">
          <h3 class="text-2xl font-bold mb-6 text-secondary-900">By the Numbers</h3>
          <div class="grid grid-cols-2 gap-6">
            <div class="text-center p-4">
              <div class="text-4xl font-bold text-primary-600 mb-2">500+</div>
              <div class="text-secondary-600 font-medium">Projects Delivered</div>
            </div>
            <div class="text-center p-4">
              <div class="text-4xl font-bold text-primary-600 mb-2">200+</div>
              <div class="text-secondary-600 font-medium">Happy Clients</div>
            </div>
            <div class="text-center p-4">
              <div class="text-4xl font-bold text-primary-600 mb-2">50+</div>
              <div class="text-secondary-600 font-medium">Team Members</div>
            </div>
            <div class="text-center p-4">
              <div class="text-4xl font-bold text-primary-600 mb-2">99.9%</div>
              <div class="text-secondary-600 font-medium">Uptime SLA</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="section-padding bg-secondary-50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="mb-4">Our Core Values</h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          The principles that guide everything we do
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {values.map((value) => (
          <div class="bg-white rounded-xl p-6 text-center hover:shadow-lg transition-shadow">
            <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-700 rounded-full flex items-center justify-center mx-auto mb-4">
              {value.icon === 'star' && (
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
              )}
              {value.icon === 'lightbulb' && (
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              )}
              {value.icon === 'shield-check' && (
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              )}
              {value.icon === 'users' && (
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
              )}
            </div>
            <h3 class="text-xl font-semibold mb-3 text-secondary-900">{value.title}</h3>
            <p class="text-secondary-600">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Leadership Team -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="mb-4">Leadership Team</h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          Industry experts dedicated to your success
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {team.map((member) => (
          <div class="text-center group">
            <div class="w-40 h-40 bg-gradient-to-br from-primary-100 to-primary-200 rounded-full mx-auto mb-4 flex items-center justify-center group-hover:from-primary-500 group-hover:to-primary-700 transition-all">
              <svg class="w-20 h-20 text-primary-600 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2 text-secondary-900">{member.name}</h3>
            <p class="text-primary-600 font-medium mb-2">{member.role}</p>
            <p class="text-sm text-secondary-600">{member.expertise}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Certifications & Partners -->
  <section class="section-padding bg-secondary-50">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="mb-4">Certifications & Partnerships</h2>
        <p class="text-xl text-secondary-600 max-w-3xl mx-auto">
          Recognized by industry leaders for our expertise and commitment to excellence
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {certifications.map((cert) => (
          <div class="bg-white rounded-xl p-6 text-center border-2 border-secondary-100 hover:border-primary-300 transition-colors">
            <svg class="w-12 h-12 text-primary-600 mx-auto mb-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <p class="font-semibold text-secondary-900">{cert}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding bg-gradient-to-r from-primary-600 to-primary-800 text-white">
    <div class="container-custom text-center">
      <h2 class="mb-6 text-white">Join Our Success Story</h2>
      <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
        Partner with a team that's committed to your success. Let's discuss how we can help achieve your IT goals.
      </p>
      <a href="/contact" class="btn bg-white text-primary-700 hover:bg-blue-50 px-8 py-4 text-lg">
        Get in Touch
      </a>
    </div>
  </section>
</Layout>
